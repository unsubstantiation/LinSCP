#!/bin/sh
# LinSCP graphical Commander launcher (pure-Rust + Tauri wrapper).
#
# Phase 6: the production GUI is now the Rust binary (target/release/linscp-gui
# via linscp-http axum server, or the Tauri desktop app). This script is kept
# for backwards compatibility so that `source/gui/linscp-gui` still works from
# a source tree and from the installed package, and so that old CI lines that
# call "$GITHUB_WORKSPACE/source/gui/linscp-gui" keep passing via the Rust
# binary.
#
# Resolution order:
#   1. Rust binary next to this script's repository (target/release/linscp-gui)
#   2. Rust binary installed (/usr/bin/linscp-gui, /usr/local/bin/linscp-gui)
#   3. Legacy Python server next to this script (for source-tree regression fallback)
#   4. Installed Python modules (/usr/share/linscp/gui/linscp_gui.py)

set -e

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$here/../.." && pwd)

# 1. Rust binary in this repository's target/
for cand in "$repo_root/target/release/linscp-gui" "$repo_root/target/debug/linscp-gui" \
            "$repo_root/target/release/linscp" "$repo_root/target/debug/linscp"; do
    if [ -x "$cand" ]; then
        exec "$cand" "$@"
    fi
done

# 2. Installed Rust binary
for cand in /usr/bin/linscp-gui /usr/local/bin/linscp-gui /usr/bin/linscp; do
    if [ -x "$cand" ]; then
        exec "$cand" "$@"
    fi
done

# 3. Legacy Python server (retained for source-tree fallback until harness migrates)
PYTHONDONTWRITEBYTECODE=1
export PYTHONDONTWRITEBYTECODE
for candidate in "$here/linscp_gui.py" \
                 "$here/../share/linscp/gui/linscp_gui.py" \
                 /usr/share/linscp/gui/linscp_gui.py; do
    if [ -f "$candidate" ]; then
        exec python3 "$candidate" "$@"
    fi
done

echo "linscp-gui: cannot find Rust binary (target/release/linscp-gui or /usr/bin/linscp-gui)" >&2
echo "  and no legacy linscp_gui.py fallback was found. Build with 'cargo build --release --workspace'." >&2
exit 1
