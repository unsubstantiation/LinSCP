    {"de", "The raw transfer setting 'CPSLimit' must be a number of bytes per second.", "Die Roh-Transfereinstellung 'CPSLimit' muss eine Anzahl von Bytes pro Sekunde sein."},
    {"de", "The raw transfer setting 'PreserveRights' must be 1 or 0.", "Die Roh-Transfereinstellung 'PreserveRights' muss 1 oder 0 sein."},
    {"de", "The raw transfer setting 'ResumeSupport' must be 0 (on), 1 (smart) or 2 (off).", "Die Roh-Transfereinstellung 'ResumeSupport' muss 0 (on), 1 (smart) oder 2 (off) sein."},
    {"de", "The raw transfer setting 'ResumeThreshold' must be a number of bytes.", "Die Roh-Transfereinstellung 'ResumeThreshold' muss eine Anzahl von Bytes sein."},
    {"de", "The raw transfer setting 'Text' is not a permission mode: {reason}", "Die Roh-Transfereinstellung 'Text' ist kein Berechtigungsmodus: {reason}"},
