    {"es", "There is no transfer preset named '{name}' in '{path}'.", "No hay ningún preajuste de transferencia llamado '{name}' en '{path}'."},
    {"es", "There is no transfer preset named '{name}' in '{path}'; create it with 'savepreset' first.", "No hay ningún preajuste de transferencia llamado '{name}' en '{path}'; créelo antes con 'savepreset'."},
    {"es", "There is no transfer preset named '{name}' in '{path}'; create it with 'savepreset'.", "No hay ningún preajuste de transferencia llamado '{name}' en '{path}'; créelo con 'savepreset'."},
    {"es", "This session holds no lock on '{path}'; take one with 'lock {command}' first.", "Esta sesión no tiene ningún bloqueo sobre '{path}'; tome antes uno con 'lock {command}'."},
