    {"de", "Warning: the cached host key uses a weak algorithm. Continuing.", "Warnung: Der zwischengespeicherte Hostschlüssel verwendet einen schwachen Algorithmus. Es wird fortgefahren."},
    {"de", "Warning: the password was stored encrypted in the session file{location}. It is readable by this account only; remove it with 'savesession {name}' after connecting with a key or an agent.", "Warnung: Das Passwort wurde verschlüsselt in der Sitzungsdatei{location} gespeichert. Es ist nur für dieses Konto lesbar; entfernen Sie es mit 'savesession {name}' nach dem Verbinden mit einem Schlüssel oder Agent."},
    {"de", "Warning: the server only offers a weak {type} algorithm ({name}). Continuing.", "Warnung: Der Server bietet nur einen schwachen {type}-Algorithmus ({name}) an. Es wird fortgefahren."},
    {"de", "Warning: this private key is in an old format; consider converting it.", "Warnung: Dieser private Schlüssel liegt in einem alten Format vor; erwägen Sie, ihn zu konvertieren."},
    {"de", "Watching '{local}' and '{remote}' every {interval} seconds. Press Ctrl-C to stop.", "'{local}' und '{remote}' werden alle {interval} Sekunden überwacht. Drücken Sie Strg-C zum Beenden."},
    {"de", "Watching for changes (interval: {interval}s)...", "Auf Änderungen wird gewartet (Intervall: {interval} s)..."},
    {"de", "Watching local changes in '{local}' and keeping remote '{remote}' up to date (full check every {interval} seconds). Press Ctrl-C to stop.", "Lokale Änderungen in '{local}' werden überwacht und '{remote}' auf dem aktuellen Stand gehalten (vollständige Prüfung alle {interval} Sekunden). Drücken Sie Strg-C zum Beenden."},
    {"de", "When several files are moved at once, the target must be an existing directory: '{path}' is not.", "Wenn mehrere Dateien auf einmal verschoben werden, muss das Ziel ein existierendes Verzeichnis sein: '{path}' ist keines."},
    {"de", "Wrong arguments of '{command}' command. {hint}", "Falsche Argumente für den Befehl '{command}'. {hint}"},
    {"de", "ascii\n  Transfers files in ASCII mode: line endings are converted\n  (CRLF to LF when downloading, LF to CRLF when uploading).", "ascii\n  Überträgt Dateien im ASCII-Modus: Zeilenenden werden umgewandelt\n  (CRLF zu LF beim Herunterladen, LF zu CRLF beim Hochladen)."},
    {"de", "attr <file>\n  Prints path, size, permissions, modification time and owner\n  of a remote file, one key/value line each.", "attr <Datei>\n  Gibt Pfad, Größe, Berechtigungen, Änderungszeit und Besitzer\n  einer entfernten Datei aus, je eine Schlüssel/Wert-Zeile."},
    {"de", "binary\n  Transfers files in binary mode (no conversion).", "binary\n  Überträgt Dateien im Binärmodus (ohne Umwandlung)."},
    {"de", "bye\n  Ends the session and exits.", "bye\n  Beendet die Sitzung und das Programm."},
    {"de", "calculate the checksum of", "Berechnen der Prüfsumme von"},
    {"de", "call <command>\n  Executes a command on the server through the SSH 'exec'\n  channel and prints its output. '! <command>' is the same.", "call <Befehl>\n  Führt einen Befehl über den SSH-Kanal 'exec' auf dem Server aus\n  und gibt seine Ausgabe aus. '! <Befehl>' bewirkt dasselbe."},
    {"de", "cd [ <directory> ]\n  Changes the remote working directory; without an argument\n  it goes to the home directory.", "cd [ <Verzeichnis> ]\n  Wechselt das entfernte Arbeitsverzeichnis; ohne Argument\n  wechselt es in das Heimatverzeichnis."},
    {"de", "change directory to", "Wechseln in das Verzeichnis"},
    {"de", "change the directory", "Wechseln in das Verzeichnis"},
    {"de", "change the permissions of", "Ändern der Berechtigungen von"},
    {"de", "checksum <algorithm> <file>\n  Calculates a checksum (sha-256, sha-1, md5 or crc32) of a\n  remote file, on the server when it can, locally otherwise.", "checksum <Algorithmus> <Datei>\n  Berechnet eine Prüfsumme (sha-256, sha-1, md5 oder crc32) einer\n  entfernten Datei, wenn möglich auf dem Server, sonst lokal."},
    {"de", "chmod <mode> <file> [ <file>... ] [ -recursive ]\n  Changes permissions of remote files. <mode> is octal\n  (644, 0700) or symbolic (u+x, go-w, a=r,go-w, u+s); with\n  -recursive everything below a directory is changed too,\n  symbolic links excepted.", "chmod <Modus> <Datei> [ <Datei>... ] [ -recursive ]\n  Ändert die Berechtigungen entfernter Dateien. <Modus> ist oktal\n  (644, 0700) oder symbolisch (u+x, go-w, a=r,go-w, u+s); mit\n  -recursive wird auch alles unterhalb eines Verzeichnisses\n  geändert, symbolische Links ausgenommen."},
    {"de", "close [ <index> ]\n  Closes the open session, or the session at the 1-based\n  <index> (only one connection is open at a time).", "close [ <Index> ]\n  Schließt die offene Sitzung oder die Sitzung mit dem 1-basierten\n  <Index> (es ist jeweils nur eine Verbindung geöffnet)."},
    {"de", "command", "Der Befehl"},
    {"de", "convert the line endings", "Umwandeln der Zeilenenden von"},
    {"de", "copy", "Kopieren von"},
    {"de", "copy to", "Kopieren nach"},
    {"de", "copyid [ <keyfile> ]\n  Installs the public key of the private key in use (or of\n  <keyfile>) into ~/.ssh/authorized_keys on the server, so\n  that later connections need no password. Requires a SFTP\n  or SCP session and a key this build can read.", "copyid [ <Schlüsseldatei> ]\n  Installiert den öffentlichen Schlüssel des verwendeten privaten\n  Schlüssels (oder von <Schlüsseldatei>) in ~/.ssh/authorized_keys\n  auf dem Server, sodass spätere Verbindungen kein Passwort\n  benötigen. Erfordert eine SFTP- oder SCP-Sitzung und einen\n  Schlüssel, den dieser Build lesen kann."},
    {"de", "cp <source> [ <source>... ] <target>\n  Copies files on the server, server-side when it can,\n  streamed through this client otherwise.", "cp <Quelle> [ <Quelle>... ] <Ziel>\n  Kopiert Dateien auf dem Server, wenn möglich serverseitig,\n  sonst durch diesen Client hindurch."},
    {"de", "create directory", "Erstellen des Verzeichnisses"},
    {"de", "create the directory", "Erstellen des Verzeichnisses"},
    {"de", "create the symbolic link", "Erstellen des symbolischen Links"},
    {"de", "delete marker", "Löschmarkierung"},
    {"de", "directory", "Verzeichnis"},
    {"de", "download", "Herunterladen von"},
    {"de", "echo <message>\n  Prints the message.", "echo <Nachricht>\n  Gibt die Nachricht aus."},
    {"de", "edit <file>\n  Downloads the file, opens it in the configured editor and\n  uploads it back when it changed.", "edit <Datei>\n  Lädt die Datei herunter, öffnet sie im eingestellten Editor und\n  lädt sie wieder hoch, wenn sie geändert wurde."},
    {"de", "etag <file> -match=ETAG | -nomatch=ETAG | -get | -clear\n  Records an ETag precondition for one WebDAV path with this\n  session: an upload, a delete or a move of that path then\n  sends it in the If header next to any lock token, so the\n  server refuses (412) a write over a version this client has\n  not seen instead of accepting it. '-get' prints the ETag the\n  server reports now and says so when the path is not there,\n  '-clear' forgets the precondition. Give exactly one of the\n  four. A protocol with no ETags is refused rather than left\n  believing a write is conditional.", "etag <Datei> -match=ETAG | -nomatch=ETAG | -get | -clear\n  Legt für einen WebDAV-Pfad in dieser Sitzung eine ETag-Vorbedingung\n  fest: Hochladen, Löschen oder Verschieben dieses Pfads sendet sie\n  dann im If-Header neben einem etwaigen Sperr-Token, sodass der\n  Server einen Schreibvorgang über eine Version, die dieser Client\n  nicht gesehen hat, ablehnt (412), statt ihn anzunehmen. '-get'\n  gibt den ETag aus, den der Server jetzt meldet, und sagt es, wenn\n  der Pfad nicht existiert; '-clear' vergisst die Vorbedingung.\n  Geben Sie genau eine der vier Angaben an. Bei einem Protokoll\n  ohne ETags wird der Befehl abgelehnt, statt den Eindruck zu\n  erwecken, ein Schreibvorgang sei an eine Bedingung geknüpft."},
    {"de", "exit\n  Ends the session and exits.", "exit\n  Beendet die Sitzung und das Programm."},
    {"de", "expand the file name", "Erweitern des Dateinamens"},
    {"de", "file", "Datei"},
    {"de", "find", "Suchen von"},
    {"de", "get [ <switches> ] <file> [ <file>... ] [ <target> ]\n  Downloads files. Switches: -delete, -resume, -append,\n  -resumesupport=on|off|<KB>, -speed=<KB/s>, -neweronly,\n  -noneweronly, -latest, -preservetime, -preservetime=all,\n  -nopreservetime, -r, -transfer=binary|ascii|automatic,\n  -permissions[=<mode>], -nopermissions, -versionid=<ID>,\n  -rawtransfersettings[=<count>], -filemask=<mask>.\n  -latest transfers only the newest file the command named,\n  by the source's modification time.\n  For S3, -versionid downloads that exact object version; it\n  stages separately per version so resumes never mix versions.\n  Without a value, -permissions gives the downloaded file\n  the permissions of the remote one.", "get [ <Schalter> ] <Datei> [ <Datei>... ] [ <Ziel> ]\n  Lädt Dateien herunter. Schalter: -delete, -resume, -append,\n  -resumesupport=on|off|<KB>, -speed=<KB/s>, -neweronly,\n  -noneweronly, -latest, -preservetime, -preservetime=all,\n  -nopreservetime, -r, -transfer=binary|ascii|automatic,\n  -permissions[=<Modus>], -nopermissions, -versionid=<ID>,\n  -rawtransfersettings[=<Anzahl>], -filemask=<Maske>.\n  -latest überträgt nur die neueste der angegebenen Dateien,\n  gemessen an der Änderungszeit der Quelle.\n  Bei S3 lädt -versionid genau diese Objektversion herunter; jede\n  Version wird getrennt zwischengespeichert, sodass eine Fortsetzung\n  nie Versionen vermischt.\n  Ohne Wert gibt -permissions der heruntergeladenen Datei die\n  Berechtigungen der entfernten Datei."},
    {"de", "get [ <switches> ] <file> [ <file>... ] [ <target> ]\n  Downloads files. Switches: -delete, -resume, -append,\n  -resumesupport=on|off|<KB>, -speed=<KB/s>, -neweronly,\n  -noneweronly, -preservetime, -preservetime=all,\n  -nopreservetime, -r, -transfer=binary|ascii|automatic,\n  -permissions[=<mode>], -nopermissions,\n  -rawtransfersettings[=<count>], -filemask=<mask>.\n  Without a value, -permissions gives the downloaded file\n  the permissions of the remote one.", "get [ <Schalter> ] <Datei> [ <Datei>... ] [ <Ziel> ]\n  Lädt Dateien herunter. Schalter: -delete, -resume, -append,\n  -resumesupport=on|off|<KB>, -speed=<KB/s>, -neweronly,\n  -noneweronly, -preservetime, -preservetime=all,\n  -nopreservetime, -r, -transfer=binary|ascii|automatic,\n  -permissions[=<Modus>], -nopermissions,\n  -rawtransfersettings[=<Anzahl>], -filemask=<Maske>.\n  Ohne Wert gibt -permissions der heruntergeladenen Datei die\n  Berechtigungen der entfernten Datei."},
    {"de", "get the ETag of", "Abrufen des ETags von"},
    {"de", "help [ <command> ]\n  Prints the list of commands, or the help of one command.", "help [ <Befehl> ]\n  Gibt die Liste der Befehle oder die Hilfe zu einem Befehl aus."},
    {"de", "inspect destination", "Prüfen des Ziels"},
    {"de", "inspect target", "Prüfen des Ziels"},
    {"de", "inspect the destination", "Prüfen des Ziels"},
    {"de", "inspect the destination of", "Prüfen des Ziels von"},
    {"de", "keepuptodate [ <localdir> [ <remotedir> ] ]\n  Reflects local changes on the remote side, watching the local\n  tree with inotify. -interval=<seconds>, -count=<passes>,\n  -delete, -continue, -filemask=, -transfer=.", "keepuptodate [ <lokales Verzeichnis> [ <entferntes Verzeichnis> ] ]\n  Überträgt lokale Änderungen auf die entfernte Seite und überwacht\n  dazu den lokalen Baum mit inotify. -interval=<Sekunden>,\n  -count=<Durchläufe>, -delete, -continue, -filemask=, -transfer=."},
    {"de", "latest", "neueste"},
    {"de", "lcd <directory>\n  Changes the local working directory.", "lcd <Verzeichnis>\n  Wechselt das lokale Arbeitsverzeichnis."},
    {"de", "lls [ <directory>[/<mask>] ]\n  Lists the local working directory.", "lls [ <Verzeichnis>[/<Maske>] ]\n  Listet das lokale Arbeitsverzeichnis auf."},
    {"de", "ln <target> <link>\n  Creates a symbolic link on the server.", "ln <Ziel> <Link>\n  Erstellt einen symbolischen Link auf dem Server."},
    {"de", "local", "lokal"},
    {"de", "lock", "Sperren von"},
    {"de", "lock <file> [-timeout=SECONDS]\n  Takes an exclusive WebDAV write lock on one file and\n  remembers its token: uploads, deletes and moves of that\n  path then carry it, so the server refuses a write the lock\n  should prevent instead of accepting it.", "lock <Datei> [-timeout=SEKUNDEN]\n  Setzt eine exklusive WebDAV-Schreibsperre auf eine Datei und\n  merkt sich ihr Token: Hochladen, Löschen und Verschieben dieses\n  Pfads senden es dann mit, sodass der Server einen Schreibvorgang,\n  den die Sperre verhindern soll, ablehnt, statt ihn anzunehmen."},
    {"de", "lpwd\n  Prints the local working directory.", "lpwd\n  Gibt das lokale Arbeitsverzeichnis aus."},
    {"de", "ls [ <directory>[/<mask>] ]\n  Lists the remote directory (switches: -l, -a, -1).", "ls [ <Verzeichnis>[/<Maske>] ]\n  Listet das entfernte Verzeichnis auf (Schalter: -l, -a, -1)."},
    {"de", "man [ <command> ]\n  Same as 'help'.", "man [ <Befehl> ]\n  Wie 'help'."},
    {"de", "mkdir [-parents] <directory>\n  Creates a remote directory. -parents creates missing parents\n  and accepts an existing directory (a LinSCP extension).", "mkdir [-parents] <Verzeichnis>\n  Erstellt ein entferntes Verzeichnis. -parents erstellt fehlende\n  übergeordnete Verzeichnisse und akzeptiert ein bereits\n  vorhandenes Verzeichnis (eine LinSCP-Erweiterung)."},
    {"de", "move", "Verschieben von"},
    {"de", "mv <source> [ <source>... ] <target>\n  Moves or renames remote files; with several sources the\n  target must be an existing directory.", "mv <Quelle> [ <Quelle>... ] <Ziel>\n  Verschiebt oder benennt entfernte Dateien um; bei mehreren\n  Quellen muss das Ziel ein vorhandenes Verzeichnis sein."},
    {"de", "open <site> [-hostkey=KEY] [-password=PWD] [-username=NAME]\n        [-privatekey=FILE] [-passphrase=PHR] [-clientcert=FILE]\n        [-timeout=SEC] [-implicit[=on|off]] [-explicit[=on|off]]\n        [-passive[=on|off]] [-sessionname=NAME]\n        [-rawsettings NAME=VALUE...]\n  Connects to a site given as a URL or a stored session name;\n  the switches apply to a stored site as well as to a URL.\n  -timeout is the server response timeout in seconds.\n  -implicit and -explicit choose the TLS mode of an FTP\n  session (implicit TLS uses port 990 when the URL names no\n  port); -passive turns the FTP data connection policy on or\n  off; -clientcert is the TLS client certificate file;\n  -sessionname is the name this connection is logged under.\n  -rawsettings sets session settings by upstream's names. This\n  build applies the proxy ones (ProxyMethod=None|SOCKS4|SOCKS5|\n  HTTP|Telnet|Cmd, ProxyHost, ProxyPort, ProxyUsername,\n  ProxyPassword, ProxyTelnetCommand, ProxyLocalCommand,\n  ProxyDNS=0|1|2, ProxyLocalhost=0|1, ProxyExcludeList), the FTP\n  engine's policy (FtpPasvMode=0|1, FtpForcePasvIp=0|1|2,\n  FtpUseMlsd=0|1|2, FtpAccount) and the TLS policy (Ftps=0|1|2|3,\n  MinTlsVersion, MaxTlsVersion, TlsCertificateFile,\n  TlsCertificateKeyFile, CaCertificateFile, CaCertificateDir,\n  PinnedPublicKey); any other setting is refused rather than\n  dropped.", "open <Verbindung> [-hostkey=SCHLÜSSEL] [-password=PASSWORT]\n        [-username=NAME] [-privatekey=DATEI] [-passphrase=PHRASE]\n        [-clientcert=DATEI] [-timeout=SEK] [-implicit[=on|off]]\n        [-explicit[=on|off]] [-passive[=on|off]] [-sessionname=NAME]\n        [-rawsettings NAME=WERT...]\n  Öffnet eine Verbindung, die als URL oder als Name einer\n  gespeicherten Sitzung angegeben wird; die Schalter gelten für\n  eine gespeicherte Verbindung ebenso wie für eine URL.\n  -timeout ist das Antwort-Timeout des Servers in Sekunden.\n  -implicit und -explicit wählen den TLS-Modus einer FTP-Sitzung\n  (implizites TLS verwendet Port 990, wenn die URL keinen Port\n  nennt); -passive schaltet die Richtlinie der FTP-Datenverbindung\n  ein oder aus; -clientcert ist die Datei des TLS-Clientzertifikats;\n  -sessionname ist der Name, unter dem diese Verbindung\n  protokolliert wird.\n  -rawsettings setzt Sitzungseinstellungen unter den Namen von\n  Upstream. Dieser Build wendet die Proxy-Einstellungen an\n  (ProxyMethod=None|SOCKS4|SOCKS5|HTTP|Telnet|Cmd, ProxyHost,\n  ProxyPort, ProxyUsername, ProxyPassword, ProxyTelnetCommand,\n  ProxyLocalCommand, ProxyDNS=0|1|2, ProxyLocalhost=0|1,\n  ProxyExcludeList), die Richtlinie der FTP-Engine (FtpPasvMode=0|1,\n  FtpForcePasvIp=0|1|2, FtpUseMlsd=0|1|2, FtpAccount) und die\n  TLS-Richtlinie (Ftps=0|1|2|3, MinTlsVersion, MaxTlsVersion,\n  TlsCertificateFile, TlsCertificateKeyFile, CaCertificateFile,\n  CaCertificateDir, PinnedPublicKey); jede andere Einstellung wird\n  abgelehnt, statt stillschweigend verworfen zu werden."},
    {"de", "option [ <name> [ <value> ] ]\n  Shows or changes a setting: echo, batch, confirm, resume,\n  transfer, include, exclude, failonnomatch, synchdelete,\n  reconnecttime, editor, editmaxsize, preset. Without a name it\n  prints every setting; a name or a value may be abbreviated\n  as long as the abbreviation is unambiguous.", "option [ <Name> [ <Wert> ] ]\n  Zeigt eine Einstellung an oder ändert sie: echo, batch, confirm,\n  resume, transfer, include, exclude, failonnomatch, synchdelete,\n  reconnecttime, editor, editmaxsize, preset. Ohne Namen werden\n  alle Einstellungen ausgegeben; ein Name oder Wert darf abgekürzt\n  werden, solange die Abkürzung eindeutig ist."},
    {"de", "option name", "Der Optionsname"},
    {"de", "prepare the destination", "Vorbereiten des Ziels"},
    {"de", "prepare the destination for", "Vorbereiten des Ziels für"},
    {"de", "presets\n  Lists the transfer presets from the user configuration.\n  A preset is stored with 'savepreset <name> <setting>...'\n  (transfer=binary|ascii|automatic, preservetime=on|off|all,\n  neweronly, speed=<KB/s>, resumesupport=on|off|<KB>,\n  permissions=<octal>|off|fromfile, host=, user=, remotedir=,\n  localdir=, mask=); 'rmspreset <name>' removes one.\n  'option preset <name>' makes a preset the default for the\n  following transfer commands, 'option preset off' disables\n  presets for this session (even matching rules); a stored\n  site loads its own when it is opened.", "presets\n  Listet die Transfer-Voreinstellungen aus der Benutzerkonfiguration.\n  Eine Voreinstellung wird mit 'savepreset <Name> <Einstellung>...'\n  gespeichert (transfer=binary|ascii|automatic,\n  preservetime=on|off|all, neweronly, speed=<KB/s>,\n  resumesupport=on|off|<KB>, permissions=<oktal>|off|fromfile,\n  host=, user=, remotedir=, localdir=, mask=); 'rmspreset <Name>'\n  entfernt eine. 'option preset <Name>' macht eine Voreinstellung\n  zum Standard für die folgenden Übertragungsbefehle;\n  'option preset off' deaktiviert Voreinstellungen für diese\n  Sitzung (auch passende Regeln); eine gespeicherte Verbindung lädt\n  beim Öffnen ihre eigene."},
    {"de", "property <file> -get=NAME | property <file> -set=NAME=VALUE\n  Reads or writes one WebDAV dead property of a file, in this\n  client's own namespace. '-get' prints 'NAME is not set' when\n  the server says the property does not exist.", "property <Datei> -get=NAME | property <Datei> -set=NAME=WERT\n  Liest oder schreibt eine WebDAV-Eigenschaft (Dead Property) einer\n  Datei im eigenen Namensraum dieses Clients. '-get' gibt\n  'NAME ist nicht gesetzt' aus, wenn der Server meldet, dass die\n  Eigenschaft nicht existiert."},
    {"de", "put [ <switches> ] <file> [ <file>... ] [ <target> ]\n  Uploads files; the switches of 'get' (on uploads,\n  -permissions without a value keeps the local file's own\n  mode on the server); -append adds to the remote file\n  instead of replacing it (native SFTP only, and not\n  together with -resume); -latest uploads only the newest\n  local file the command named.", "put [ <Schalter> ] <Datei> [ <Datei>... ] [ <Ziel> ]\n  Lädt Dateien hoch; es gelten die Schalter von 'get' (beim\n  Hochladen behält -permissions ohne Wert den Modus der lokalen\n  Datei auf dem Server bei); -append hängt an die entfernte Datei\n  an, statt sie zu ersetzen (nur natives SFTP und nicht zusammen\n  mit -resume); -latest lädt nur die neueste der angegebenen\n  lokalen Dateien hoch."},
    {"de", "pwd\n  Prints the remote working directory.", "pwd\n  Gibt das entfernte Arbeitsverzeichnis aus."},
    {"de", "read", "Lesen von"},
    {"de", "read directory", "Lesen des Verzeichnisses"},
    {"de", "read the attributes of", "Lesen der Attribute von"},
    {"de", "read the property of", "Lesen der Eigenschaft von"},
    {"de", "remote", "entfernt"},
    {"de", "remove", "Entfernen von"},
    {"de", "remove directory", "Entfernen des Verzeichnisses"},
    {"de", "remove file", "Entfernen der Datei"},
    {"de", "remove the directory", "Entfernen des Verzeichnisses"},
    {"de", "rm [ -onlyfile ] <file> [ <file>... ]\n  Deletes remote files (masks allowed); -onlyfile skips\n  directories.", "rm [ -onlyfile ] <Datei> [ <Datei>... ]\n  Löscht entfernte Dateien (Masken erlaubt); -onlyfile überspringt\n  Verzeichnisse."},
    {"de", "rm [ -onlyfile ] [ -versionid=ID ] <file> [ <file>... ]\n  Deletes remote files (masks allowed); -onlyfile skips\n  directories. On S3, -versionid deletes just that version\n  (including a delete marker) instead of the current object.", "rm [ -onlyfile ] [ -versionid=ID ] <Datei> [ <Datei>... ]\n  Löscht entfernte Dateien (Masken erlaubt); -onlyfile überspringt\n  Verzeichnisse. Bei S3 löscht -versionid nur diese Version\n  (auch eine Löschmarkierung) statt des aktuellen Objekts."},
    {"de", "rmdir <directory> [ <directory>... ]\n  Deletes empty remote directories.", "rmdir <Verzeichnis> [ <Verzeichnis>... ]\n  Löscht leere entfernte Verzeichnisse."},
    {"de", "rmsession <name>\n  Removes the stored session <name>.", "rmsession <Name>\n  Entfernt die gespeicherte Sitzung <Name>."},
    {"de", "rmspreset <name>\n  Removes the transfer preset <name>; if it was active,\n  transfers go back to their own settings.", "rmspreset <Name>\n  Entfernt die Transfer-Voreinstellung <Name>; war sie aktiv,\n  verwenden Übertragungen wieder ihre eigenen Einstellungen."},
    {"de", "run the command on", "Ausführen des Befehls auf"},
    {"de", "savepreset <name> <setting>[=<value>]...\n  Stores or updates a transfer preset; settings without a\n  value (neweronly) are switches. See 'help presets'.", "savepreset <Name> <Einstellung>[=<Wert>]...\n  Speichert oder aktualisiert eine Transfer-Voreinstellung;\n  Einstellungen ohne Wert (neweronly) sind Schalter. Siehe\n  'help presets'."},
    {"de", "savesession <name> [ options ]\n  Stores the current session, or the one the options\n  describe, under <name>; -preset=NAME also stores the\n  transfer preset the site should load (-preset= clears it),\n  and -rawsettings NAME=VALUE... stores session settings with\n  it (the ones 'open -rawsettings' applies: proxy, FTP engine\n  and TLS policy; a proxy password is encrypted like a session\n  password).", "savesession <Name> [ Optionen ]\n  Speichert die aktuelle Sitzung oder die durch die Optionen\n  beschriebene unter <Name>; -preset=NAME speichert zusätzlich die\n  Transfer-Voreinstellung, die die Verbindung laden soll (-preset=\n  löscht sie), und -rawsettings NAME=WERT... speichert\n  Sitzungseinstellungen mit (diejenigen, die 'open -rawsettings'\n  anwendet: Proxy, FTP-Engine und TLS-Richtlinie; ein\n  Proxy-Passwort wird wie ein Sitzungspasswort verschlüsselt)."},
    {"de", "session [ <index> ]\n  Lists the open sessions and prints which one is active;\n  with a 1-based <index> it switches to that session.", "session [ <Index> ]\n  Listet die offenen Sitzungen auf und zeigt, welche aktiv ist;\n  mit einem 1-basierten <Index> wird zu dieser Sitzung gewechselt."},
    {"de", "sessions [ NAME | list | export <file> | import <file> ]\n  Lists the stored sites, opens one by name, or exports and\n  imports the whole list.", "sessions [ NAME | list | export <Datei> | import <Datei> ]\n  Listet die gespeicherten Verbindungen auf, öffnet eine nach Namen\n  oder exportiert bzw. importiert die gesamte Liste."},
    {"de", "set the permissions", "Setzen der Berechtigungen von"},
    {"de", "set the property of", "Setzen der Eigenschaft von"},
    {"de", "show\n  Not available in this build: the connection runs the SFTP\n  subsystem, so remote shell commands cannot be shown.", "show\n  In diesem Build nicht verfügbar: Die Verbindung nutzt das\n  SFTP-Subsystem, daher können entfernte Shell-Befehle nicht\n  angezeigt werden."},
    {"de", "stat <file>\n  Prints the listing line of a remote path, as ls -l shows\n  it. The key/value breakdown of attr stays available there.", "stat <Datei>\n  Gibt die Listenzeile eines entfernten Pfads aus, wie ls -l sie\n  zeigt. Die Schlüssel/Wert-Aufschlüsselung liefert weiterhin attr."},
    {"de", "supported: echo, batch, confirm, resume, transfer, include, exclude, failonnomatch, synchdelete, reconnecttime, editor, editmaxsize, preset", "unterstützt: echo, batch, confirm, resume, transfer, include, exclude, failonnomatch, synchdelete, reconnecttime, editor, editmaxsize, preset"},
    {"de", "symlink <target> <link>\n  Same as 'ln'.", "symlink <Ziel> <Link>\n  Wie 'ln'."},
    {"de", "synchronize local|remote|both [ <localdir> [ <remotedir> ] ]\n  [ -delete ] [-nodelete] [-mirror] [-preview]\n  [-criteria=time|size|checksum|either|both|none] [-filemask=<mask>]\n  [-transfer=binary|ascii|automatic] [-nonrecursive]\n  The criteria say what counts as a change: 'time' (the\n  default) copies a file the source has newer, 'size' one of\n  a different size, 'checksum' one whose contents differ and\n  'none' every file. 'either' and its synonym 'both' compare\n  the time and the size, and the three comparisons may also\n  be listed, as in -criteria=time,checksum. In the 'both'\n  direction the record of the previous synchronization\n  decides, so 'checksum' and 'none' are refused there.", "synchronize local|remote|both [ <lokales Verzeichnis> [ <entferntes Verzeichnis> ] ]\n  [ -delete ] [-nodelete] [-mirror] [-preview]\n  [-criteria=time|size|checksum|either|both|none] [-filemask=<Maske>]\n  [-transfer=binary|ascii|automatic] [-nonrecursive]\n  Die Kriterien legen fest, was als Änderung gilt: 'time' (die\n  Vorgabe) kopiert eine Datei, die in der Quelle neuer ist, 'size'\n  eine mit anderer Größe, 'checksum' eine mit abweichendem Inhalt\n  und 'none' jede Datei. 'either' und sein Synonym 'both'\n  vergleichen Zeit und Größe; die drei Vergleiche können auch\n  aufgezählt werden, etwa -criteria=time,checksum. In der Richtung\n  'both' entscheidet der Datensatz der vorherigen Synchronisation,\n  daher werden 'checksum' und 'none' dort abgelehnt."},
    {"de", "terminal\n  Opens an interactive shell terminal on the server.", "terminal\n  Öffnet ein interaktives Shell-Terminal auf dem Server."},
    {"de", "the file has none.", "die Datei enthält keine."},
    {"de", "unlock", "Entsperren von"},
    {"de", "unlock <file>\n  Releases the lock 'lock <file>' took in this session.", "unlock <Datei>\n  Gibt die Sperre frei, die 'lock <Datei>' in dieser Sitzung\n  gesetzt hat."},
    {"de", "upload", "Hochladen von"},
    {"de", "upload to", "Hochladen nach"},
    {"de", "value of the option '{name}'", "Der Wert der Option '{name}'"},
    {"de", "version", "Version"},
    {"de", "versions [ <object-or-prefix> ]\n  Lists S3 object versions and delete markers. An object path\n  lists that exact key; a bucket or trailing-slash prefix\n  lists every matching key. Results are paginated.", "versions [ <Objekt-oder-Präfix> ]\n  Listet S3-Objektversionen und Löschmarkierungen auf. Ein\n  Objektpfad listet genau diesen Schlüssel; ein Bucket oder ein\n  Präfix mit abschließendem Schrägstrich listet alle passenden\n  Schlüssel. Die Ergebnisse werden seitenweise abgerufen."},
    {"de", "{algorithm} checksum of '{path}': {hash}", "{algorithm}-Prüfsumme von '{path}': {hash}"},
