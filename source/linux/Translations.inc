    {"de", "The transfer completed, but '{path}' could not be inspected for the final move ({reason}); the complete file is at '{part}'.", "Die Übertragung ist abgeschlossen, aber '{path}' konnte für das abschließende Verschieben nicht geprüft werden ({reason}); die vollständige Datei liegt unter '{part}'."},
    {"de", "The transfer completed, but '{path}' could not be put in place ({reason}); the complete file is at '{part}'.", "Die Übertragung ist abgeschlossen, aber '{path}' konnte nicht an seinen Platz gebracht werden ({reason}); die vollständige Datei liegt unter '{part}'."},
    {"de", "The transfer completed, but '{path}' could not be replaced ({reason}); the complete file is at '{part}'.", "Die Übertragung ist abgeschlossen, aber '{path}' konnte nicht ersetzt werden ({reason}); die vollständige Datei liegt unter '{part}'."},
    {"de", "The transfer preset '{name}' does not exist in '{path}' any more; pick another with 'option preset <name>' or clear it with 'option preset off'.", "Die Transfer-Voreinstellung '{name}' existiert in '{path}' nicht mehr; wählen Sie eine andere mit 'option preset <name>' oder löschen Sie sie mit 'option preset off'."},
    {"de", "The tunnel host key is not cached; use -rawsettings TunnelHostKey=FINGERPRINT to accept it", "Der Hostschlüssel des Tunnels ist nicht zwischengespeichert; verwenden Sie -rawsettings TunnelHostKey=FINGERABDRUCK, um ihn zu akzeptieren"},
