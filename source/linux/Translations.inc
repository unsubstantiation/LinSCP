    {"es", "Syntax: {command}{modes} [-delete] [-nodelete] [-mirror] [-preview] [-nonrecursive] [-criteria=time|size|checksum|either|both|none] [-filemask=MASK] [-transfer=binary|ascii|automatic] [-interval=SECS] [-count=N] [-continue].", "Sintaxis: {command}{modes} [-delete] [-nodelete] [-mirror] [-preview] [-nonrecursive] [-criteria=time|size|checksum|either|both|none] [-filemask=MASK] [-transfer=binary|ascii|automatic] [-interval=SECS] [-count=N] [-continue]."},
    {"es", "The 'versions' command is available only for S3 sessions.", "La orden 'versions' solo está disponible en sesiones S3."},
    {"es", "The -filemask switch overrides the include/exclude option mask for this command.", "La opción -filemask sustituye la máscara include/exclude de esta orden."},
    {"es", "The PuTTY key file '{key}' is not passed to the system ssh client; the terminal will use the agent or ask for a password.", "El archivo de clave PuTTY '{key}' no se pasa al cliente ssh del sistema; el terminal usará el agente o pedirá una contraseña."},
    {"es", "The command takes no arguments.", "La orden no admite argumentos."},
    {"es", "The connection runs the SFTP subsystem, so remote shell commands are not available in this build.", "La conexión usa el subsistema SFTP, así que las órdenes de shell remotas no están disponibles en esta compilación."},
    {"es", "The connection was lost; reconnecting to {host}...", "Se ha perdido la conexión; reconectando a {host}..."},
    {"es", "The count must be a positive number of passes.", "La cuenta debe ser un número positivo de pasadas."},
    {"es", "The home directory of the session is not known, so ~/.ssh/authorized_keys cannot be located.", "No se conoce el directorio personal de la sesión, así que no se puede localizar ~/.ssh/authorized_keys."},
    {"es", "The host key of {host} (port {port}) does not match the cached key.\n  {type} key fingerprint: {fingerprint}\nThe connection may be intercepted; refusing to continue.", "La clave del servidor {host} (puerto {port}) no coincide con la clave guardada.\n  Huella de la clave {type}: {fingerprint}\nLa conexión puede estar interceptada; se rechaza continuar."},
    {"es", "The host key of {host} (port {port}) is not cached.\n  {type} key fingerprint: {fingerprint}\nIf you expected a different fingerprint, do not continue.", "La clave del servidor {host} (puerto {port}) no está guardada.\n  Huella de la clave {type}: {fingerprint}\nSi esperaba una huella diferente, no continúe."},
    {"es", "The host key of {host} (port {port}) is not the expected one.\n  {type} key fingerprint: {fingerprint}\n  expected fingerprint:           {expected}\nThe connection may be intercepted; refusing to continue.", "La clave del servidor {host} (puerto {port}) no es la esperada.\n  Huella de la clave {type}: {fingerprint}\n  Huella esperada:                {expected}\nLa conexión puede estar interceptada; se rechaza continuar."},
    {"es", "The interval must be between 1 and 86400 seconds.", "El intervalo debe estar entre 1 y 86400 segundos."},
    {"es", "The key is already installed in '{path}'.", "La clave ya está instalada en '{path}'."},
    {"es", "The key is already installed.", "La clave ya está instalada."},
    {"es", "The only value of '-preservetime' is 'all' (directories are timed too); use '-nopreservetime' to keep no timestamps.", "El único valor de '-preservetime' es 'all' (los directorios también se marcan); use '-nopreservetime' para no conservar marcas de tiempo."},
    {"es", "The option '{name}' is not supported by this build.", "La opción '{name}' no está admitida por esta compilación."},
    {"es", "The password of this connection is not known (it was typed or taken from a key or an agent), so it cannot be stored.", "La contraseña de esta conexión no se conoce (se tecleó o se tomó de una clave o de un agente), así que no se puede guardar."},
    {"es", "The plan has {count} conflict(s); nothing was deleted. Resolve the conflicts (or synchronize without -delete) and run the synchronization again.", "El plan tiene {count} conflicto(s); no se ha eliminado nada. Resuelva los conflictos (o sincronice sin -delete) y ejecute la sincronización otra vez."},
    {"es", "The preset name '{name}' is not valid.", "El nombre del preajuste '{name}' no es válido."},
    {"es", "The proxy of the stored session '{name}' cannot be used: {reason}. The site is not opened without the proxy it was stored with; store the proxy again with 'savesession {name} -rawsettings ProxyMethod=... ProxyHost=...'.", "El proxy de la sesión guardada '{name}' no se puede usar: {reason}. El sitio no se abre sin el proxy con el que se guardó; guarde el proxy otra vez con 'savesession {name} -rawsettings ProxyMethod=... ProxyHost=...'."},
    {"es", "The raw transfer setting 'CPSLimit' must be a number of bytes per second.", "El ajuste de transferencia 'CPSLimit' debe ser un número de bytes por segundo."},
    {"es", "The raw transfer setting 'PreserveRights' must be 1 or 0.", "El ajuste de transferencia 'PreserveRights' debe ser 1 o 0."},
    {"es", "The raw transfer setting 'ResumeSupport' must be 0 (on), 1 (smart) or 2 (off).", "El ajuste de transferencia 'ResumeSupport' debe ser 0 (on), 1 (smart) o 2 (off)."},
    {"es", "The raw transfer setting 'ResumeThreshold' must be a number of bytes.", "El ajuste de transferencia 'ResumeThreshold' debe ser un número de bytes."},
    {"es", "The raw transfer setting 'Text' is not a permission mode: {reason}", "El ajuste de transferencia 'Text' no es un modo de permisos: {reason}"},
    {"es", "The raw transfer setting 'TransferMode' must be 0 (binary), 1 (ascii) or 2 (automatic).", "El ajuste de transferencia 'TransferMode' debe ser 0 (binario), 1 (ascii) o 2 (automático)."},
    {"es", "The raw transfer setting '{name}' has no equivalent in this build and will not be ignored.", "El ajuste de transferencia '{name}' no tiene equivalente en esta compilación y no se ignorará."},
    {"es", "The raw transfer setting '{name}' is not known to this build; the settings it accepts are TransferMode, PreserveTime, PreserveTimeDirs, ResumeSupport, ResumeThreshold, CPSLimit, NewerOnly, PreserveRights and Text.", "El ajuste de transferencia '{name}' no lo conoce esta compilación; los ajustes que admite son TransferMode, PreserveTime, PreserveTimeDirs, ResumeSupport, ResumeThreshold, CPSLimit, NewerOnly, PreserveRights y Text."},
    {"es", "The raw transfer setting '{name}' must be 1 or 0.", "El ajuste de transferencia '{name}' debe ser 1 o 0."},
    {"es", "The remote side closed the connection.", "El lado remoto ha cerrado la conexión."},
    {"es", "The remote side disconnected.", "El lado remoto se ha desconectado."},
    {"es", "The server cannot copy files by itself; copying through this client.", "El servidor no puede copiar archivos por sí mismo; la copia pasa por este cliente."},
    {"es", "The server reported no ETag for '{path}'.", "El servidor no reportó ningún ETag de '{path}'."},
    {"es", "The session name '{name}' is not valid.", "El nombre de sesión '{name}' no es válido."},
    {"es", "The stored password of session '{name}' cannot be used: {reason}. Continuing without it.", "La contraseña guardada de la sesión '{name}' no se puede usar: {reason}. Se continúa sin ella."},
    {"es", "The transfer completed, but '{path}' could not be inspected for the final move ({reason}); the complete file is at '{part}'.", "La transferencia se completó, pero '{path}' no se pudo inspeccionar para el movimiento final ({reason}); el archivo completo está en '{part}'."},
    {"es", "The transfer completed, but '{path}' could not be put in place ({reason}); the complete file is at '{part}'.", "La transferencia se completó, pero '{path}' no se pudo colocar ({reason}); el archivo completo está en '{part}'."},
    {"es", "The transfer completed, but '{path}' could not be replaced ({reason}); the complete file is at '{part}'.", "La transferencia se completó, pero '{path}' no se pudo sustituir ({reason}); el archivo completo está en '{part}'."},
    {"es", "The transfer preset '{name}' does not exist in '{path}' any more; pick another with 'option preset <name>' or clear it with 'option preset off'.", "El preajuste de transferencia '{name}' ya no existe en '{path}'; elija otro con 'option preset <name>' o quítelo con 'option preset off'."},
    {"es", "The value '{value}' of '-transfer' is ambiguous: it matches {matches}.", "El valor '{value}' de '-transfer' es ambiguo: coincide con {matches}."},
    {"es", "The value of '-eol' must be preserve, lf or crlf.", "El valor de '-eol' debe ser preserve, lf o crlf."},
    {"es", "The value of '-monitor' must be a positive number of passes.", "El valor de '-monitor' debe ser un número positivo de pasadas."},
    {"es", "The value of '-permissions' must be an octal number from 0 through 7777.", "El valor de '-permissions' debe ser un número octal del 0 al 7777."},
    {"es", "The value of '-rawsettings' is the number of settings that follow it, as in '-rawsettings=2'.", "El valor de '-rawsettings' es el número de ajustes que le siguen, como en '-rawsettings=2'."},
    {"es", "The value of '-rawtransfersettings' is the number of settings that follow it, as in '-rawtransfersettings=2'.", "El valor de '-rawtransfersettings' es el número de ajustes que le siguen, como en '-rawtransfersettings=2'."},
    {"es", "The value of '-resumesupport' must be on, off or a number of kilobytes a file must reach to be resumed.", "El valor de '-resumesupport' debe ser on, off o un número de kilobytes que un archivo debe alcanzar para reanudarse."},
    {"es", "The value of '-speed' must be a whole number of kilobytes per second (0 removes the limit).", "El valor de '-speed' debe ser un número entero de kilobytes por segundo (0 quita el límite)."},
    {"es", "The value of '-timeout' is the number of seconds the server should keep the lock for.", "El valor de '-timeout' es el número de segundos que el servidor debe mantener el bloqueo."},
    {"es", "The value of '-transfer' must be binary, ascii or automatic.", "El valor de '-transfer' debe ser binary, ascii o automatic."},
    {"es", "The value of '-versionid' cannot be empty.", "El valor de '-versionid' no puede estar vacío."},
    {"es", "The value of 'batch' must be 'on', 'off', 'abort' or 'continue'.", "El valor de 'batch' debe ser 'on', 'off', 'abort' o 'continue'."},
    {"es", "The value of 'editmaxsize' must be a number of bytes.", "El valor de 'editmaxsize' debe ser un número de bytes."},
    {"es", "The value of 'editmaxsize' must be a positive number of bytes.", "El valor de 'editmaxsize' debe ser un número positivo de bytes."},
    {"es", "The value of 'reconnecttime' must be a number of seconds from 1 to 3600, or 'off'.", "El valor de 'reconnecttime' debe ser un número de segundos entre 1 y 3600, o 'off'."},
    {"es", "The value of 'resume' must be on, off or automatic.", "El valor de 'resume' debe ser on, off o automatic."},
    {"es", "The {what} '{name}' is ambiguous: it matches {matches}. Type them out in full.", "{what} '{name}' es ambiguo: coincide con {matches}. Escriba el nombre completo."},
    {"es", "There are no session folders.", "No hay ninguna carpeta de sesiones."},
    {"es", "There are no stored sessions in folder '{folder}'.", "No hay ninguna sesión guardada en la carpeta '{folder}'."},
    {"es", "There are no stored sessions. Use 'savesession <name>' to store the current connection.", "No hay ninguna sesión guardada. Use 'savesession <name>' para guardar la conexión actual."},
    {"es", "There are no transfer presets in '{path}' (create one with 'savepreset').", "No hay ningún preajuste de transferencia en '{path}' (cree uno con 'savepreset')."},
    {"es", "There is no host to store: connect first, or give -host=HOST.", "No hay ningún servidor que guardar: conéctese primero o dé -host=HOST."},
    {"es", "There is no private key: connect with -privatekey=<file>, or give the key file to the command.", "No hay ninguna clave privada: conéctese con -privatekey=<file>, o dé el archivo de clave a la orden."},
    {"es", "There is no stored session named '{name}'.", "No hay ninguna sesión guardada llamada '{name}'."},
