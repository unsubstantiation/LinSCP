    {"es", "'-versionid' is available only for S3 downloads.", "'-versionid' solo está disponible para descargas de S3."},
    {"es", "'-versionid' is available only for S3 object versions.", "'-versionid' solo está disponible para versiones de objetos de S3."},
    {"es", "'-versionid' needs one exact S3 object path and one optional local destination; wildcards and multiple sources are not supported.", "'-versionid' requiere una ruta exacta de objeto S3 y un destino local opcional; no se admiten comodines ni varias fuentes."},
    {"es", "'-versionid' needs one exact S3 object path; '-onlyfile', wildcards and multiple paths are not supported.", "'-versionid' requiere una ruta exacta de objeto S3; no se admiten '-onlyfile', comodines ni varias rutas."},
    {"es", "'{mode}' is not a valid mode: {reason}. Use an octal number such as 644 or an expression such as u+x.", "'{mode}' no es un modo válido: {reason}. Use un número octal como 644 o una expresión como u+x."},
