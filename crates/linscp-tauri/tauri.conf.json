{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LinSCP",
  "version": "0.1.0",
  "identifier": "io.linscp.commander",
  "build": {
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "LinSCP",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 540,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  }
}
