{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LinSCP",
  "version": "0.1.0",
  "identifier": "io.linscp.commander",
  "build": {
    "frontendDist": "../../ui/dist",
    "beforeBuildCommand": "npm --prefix ../../ui run build"
  },
  "bundle": {
    "active": true,
    "targets": ["app", "deb", "appimage", "nsis"],
    "icon": ["../../logo/linscp.png"],
    "android": {
      "minSdkVersion": 26
    }
  },
  "app": {
    "windows": [
      {
        "title": "LinSCP",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 540,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
