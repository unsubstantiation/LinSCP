#!/usr/bin/make -f
# Debian build rules for LinSCP.
#
# This package deliberately does not use debhelper: the whole build is one
# plain Makefile (source/linux/Makefile), so the few targets are written out
# here and the build dependency list stays at dpkg-dev.

package := linscp
destdir := debian/$(package)

# dpkg-buildpackage calls clean, build and binary; make everything else a
# no-op so that extra targets it may probe do not fail the build.
%:
	@:

build: build-stamp

build-stamp:
	$(MAKE) -C source/linux all check
	touch $@

# The tree this package installs is the tree 'make -C source/linux install'
# and 'cmake --install' produce: the client in bin/, the graphical client's
# modules, its command templates and its web client under share/linscp/gui/,
# the PowerShell module under share/linscp/automation/, the .NET assembly
# sources under share/linscp/dotnet/, the manual page, the desktop entry
# and the icons. The command templates are listed because
# without them an installed client starts with an empty command list, where
# a run from the source tree offers the shipped ones.
binary: build
	rm -rf $(destdir)
	install -d $(destdir)/usr/bin
	install -d $(destdir)/usr/share/man/man1
	install -d $(destdir)/usr/share/doc/$(package)
	install -d $(destdir)/usr/share/applications
	install -d $(destdir)/usr/share/pixmaps
	install -d $(destdir)/usr/share/icons/hicolor/scalable/apps
	install -d $(destdir)/usr/share/linscp/gui/web
	install -d $(destdir)/usr/share/linscp/automation
	install -d $(destdir)/usr/share/linscp/dotnet
	install -d $(destdir)/DEBIAN
	install -m 0755 source/linux/build/linscp $(destdir)/usr/bin/linscp
	install -m 0755 source/gui/linscp-gui $(destdir)/usr/bin/linscp-gui
	install -m 0644 source/gui/linscp_gui.py source/gui/linscp_crypto.py \
		$(destdir)/usr/share/linscp/gui/
	install -m 0644 source/gui/explorer-commands.json $(destdir)/usr/share/linscp/gui/
	install -m 0644 $(shell find source/gui/web -maxdepth 1 -type f) \
		$(destdir)/usr/share/linscp/gui/web/
	install -d $(destdir)/usr/share/linscp/gui/web/vendor
	install -m 0644 source/gui/web/vendor/* $(destdir)/usr/share/linscp/gui/web/vendor/
	install -m 0644 automation/LinSCP.psm1 $(destdir)/usr/share/linscp/automation/
	install -m 0644 automation/dotnet/LinSCP/LinSCP.csproj \
		automation/dotnet/LinSCP/Session.cs \
		automation/dotnet/LinSCP/WinSCPCompat.cs \
		$(destdir)/usr/share/linscp/dotnet/
	install -m 0644 debian/linscp.desktop $(destdir)/usr/share/applications/linscp.desktop
	install -m 0644 debian/linscp.png $(destdir)/usr/share/pixmaps/linscp.png
	install -m 0644 debian/linscp.svg $(destdir)/usr/share/icons/hicolor/scalable/apps/linscp.svg
	install -m 0644 docs/linscp.1 $(destdir)/usr/share/man/man1/linscp.1
	gzip -9f $(destdir)/usr/share/man/man1/linscp.1
	install -m 0644 debian/copyright $(destdir)/usr/share/doc/$(package)/copyright
	install -m 0644 LICENSE $(destdir)/usr/share/doc/$(package)/LICENSE
	install -m 0644 NOTICE $(destdir)/usr/share/doc/$(package)/NOTICE
	install -m 0644 docs/debian.md $(destdir)/usr/share/doc/$(package)/README.Debian
	dpkg-shlibdeps -Tdebian/substvars $(destdir)/usr/bin/linscp
	dpkg-gencontrol -p$(package) -P$(destdir)
	dpkg-deb --build $(destdir) ..

clean:
	$(MAKE) -C source/linux clean
	rm -f build-stamp
	rm -rf $(destdir) debian/files debian/substvars
