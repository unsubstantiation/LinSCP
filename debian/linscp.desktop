[Desktop Entry]
Version=1.0
Type=Application
Name=LinSCP
GenericName=Secure File Transfer Client
Comment=Dual-Pane File Transfer Client
Exec=linscp-gui %u
TryExec=linscp-gui
Icon=linscp
Terminal=false
Categories=Network;FileTransfer;
MimeType=x-scheme-handler/sftp;x-scheme-handler/ssh;x-scheme-handler/scp;x-scheme-handler/ftp;x-scheme-handler/ftps;x-scheme-handler/ftpes;x-scheme-handler/dav;x-scheme-handler/davs;x-scheme-handler/webdav;x-scheme-handler/webdavs;x-scheme-handler/s3;
Keywords=sftp;ftp;ftps;webdav;s3;scp;
StartupNotify=false
